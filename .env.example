# Copy to .env and adjust. Application settings are ASSISTANT_* environment variables (PY-13).
# Write values without quotes: `make` reads this file as KEY=value lines.

# Required. Root directory for uploaded documents, notes and other local data.
ASSISTANT_DATA_DIR=./data/storage

# Optional. Ports used by `make dev` (defaults 8000 and 5173).
# API_PORT=8000
# UI_PORT=5173
