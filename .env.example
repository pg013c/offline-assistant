# Copy to .env and adjust. Application settings are ASSISTANT_* environment variables (PY-13).
# Write values without quotes: `make` reads this file as KEY=value lines.

# Required. Root directory for uploaded documents, notes and other local data.
ASSISTANT_DATA_DIR=./data/storage

# Where `make models` stores the parsing and embedding models. Required by the API;
# `make` targets default it to ./data/models.
# ASSISTANT_MODELS_DIR=./data/models

# Document parser: docling (default; PDF, DOCX, images, text) or text-only (.txt and .md).
# ASSISTANT_DOCUMENT_PARSER=docling

# Qdrant, started by `make qdrant` (Docker). QDRANT_PORT is the port `make qdrant` publishes.
# ASSISTANT_QDRANT_URL=http://127.0.0.1:6333
# QDRANT_PORT=6333
# Collections are named <prefix>-<embedding model>-v<schema>; the journeys use their own prefix.
# ASSISTANT_QDRANT_COLLECTION_PREFIX=assistant
# Dense similarity a passage needs to be cited (0 to 1).
# ASSISTANT_MIN_SIMILARITY=0.5

# Chat model. Only the deterministic test model exists until F-06.
# ASSISTANT_CHAT_MODEL=fake-extractive

# Optional. Ports used by `make dev` (defaults 8000 and 5173).
# API_PORT=8000
# UI_PORT=5173
