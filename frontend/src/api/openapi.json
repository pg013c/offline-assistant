{
  "openapi": "3.1.0",
  "info": {
    "title": "Offline Assistant",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "description": "Report that the API is up, which version is running and whether network mode is on.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "List Documents",
        "description": "All uploaded documents.",
        "operationId": "list_documents",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentResponse"
                  },
                  "type": "array",
                  "title": "Response List Documents"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Upload Document",
        "description": "Upload a document to be parsed in the background; known content returns as stored.\n\nAccepts PDF, DOCX, PNG, JPG, plain text and Markdown. The document is listed with status\n`processing` until parsing ends with `ready` or `failed`.",
        "operationId": "upload_document",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{document_id}": {
      "delete": {
        "tags": [
          "documents"
        ],
        "summary": "Delete Document",
        "description": "Delete a document, its files and its passages from the search index.",
        "operationId": "delete_document",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{document_id}/reindex": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Reindex Document",
        "description": "Parse and index a document again; it is `processing` until it is `ready` or `failed`.",
        "operationId": "reindex_document",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{document_id}/chunks": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "List Document Chunks",
        "description": "The passages of a document with their locations, in order.",
        "operationId": "list_document_chunks",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChunkSummary"
                  },
                  "title": "Response List Document Chunks"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Ask Question",
        "description": "Answer a question from the uploaded documents as Server-Sent Events.",
        "operationId": "ask_question",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/ChatEvent"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Search Passages",
        "description": "The best-matching passages for a query, best first, without a similarity threshold.\n\nUsed by the evaluation harness and for debugging retrieval. Asking for reranking when\nthe server has no reranker is a 409 `reranker_off`.",
        "operationId": "search_passages",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "type": "array",
                  "title": "Response Search Passages"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes": {
      "get": {
        "tags": [
          "notes"
        ],
        "summary": "List Notes",
        "description": "The notes the agent saved, newest first.",
        "operationId": "list_notes",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NoteSummary"
                  },
                  "type": "array",
                  "title": "Response List Notes"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{note_id}": {
      "get": {
        "tags": [
          "notes"
        ],
        "summary": "Get Note",
        "description": "One note: its content, the passages it cites and the Markdown file's text.",
        "operationId": "get_note",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "List Models",
        "description": "The models a question can name now; the default answers when none is named.",
        "operationId": "list_models",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelChoiceResponse"
                  },
                  "type": "array",
                  "title": "Response List Models"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_document": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document"
      },
      "ChatCitationEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "citation",
            "title": "Type"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "document_title": {
            "type": "string",
            "title": "Document Title"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "location": {
            "$ref": "#/components/schemas/CitationLocation"
          }
        },
        "type": "object",
        "required": [
          "type",
          "number",
          "chunk_id",
          "document_id",
          "document_title",
          "quote",
          "location"
        ],
        "title": "ChatCitationEvent",
        "description": "A passage the answer is based on, quoted verbatim."
      },
      "ChatDiscardEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "discard",
            "title": "Type"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "type",
          "reason"
        ],
        "title": "ChatDiscardEvent",
        "description": "The text sent since the last discard (or the start) is void; the retry's text follows."
      },
      "ChatEndEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "end",
            "title": "Type"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "found": {
            "type": "boolean",
            "title": "Found"
          },
          "is_test_model": {
            "type": "boolean",
            "title": "Is Test Model"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "type",
          "model_id",
          "found",
          "is_test_model",
          "usage"
        ],
        "title": "ChatEndEvent",
        "description": "The last event of an answer; `usage` is null when no model answered."
      },
      "ChatErrorEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "error",
            "title": "Type"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid_answer",
              "model_unreachable",
              "model_timeout",
              "model_error"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "type",
          "code",
          "message"
        ],
        "title": "ChatErrorEvent",
        "description": "The model gave no valid answer; an end event still follows."
      },
      "ChatEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatToolEvent"
          },
          {
            "$ref": "#/components/schemas/ChatNoteEvent"
          },
          {
            "$ref": "#/components/schemas/ChatTextEvent"
          },
          {
            "$ref": "#/components/schemas/ChatDiscardEvent"
          },
          {
            "$ref": "#/components/schemas/ChatErrorEvent"
          },
          {
            "$ref": "#/components/schemas/ChatCitationEvent"
          },
          {
            "$ref": "#/components/schemas/ChatEndEvent"
          }
        ],
        "title": "ChatEvent",
        "description": "One event of a streamed answer: tool, note, text, discard, error, citation or end.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "citation": "#/components/schemas/ChatCitationEvent",
            "discard": "#/components/schemas/ChatDiscardEvent",
            "end": "#/components/schemas/ChatEndEvent",
            "error": "#/components/schemas/ChatErrorEvent",
            "note": "#/components/schemas/ChatNoteEvent",
            "text": "#/components/schemas/ChatTextEvent",
            "tool": "#/components/schemas/ChatToolEvent"
          }
        }
      },
      "ChatNoteEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "note",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "type",
          "id",
          "title"
        ],
        "title": "ChatNoteEvent",
        "description": "The agent saved a note for the user (F-07a)."
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatTextEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "text",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "ChatTextEvent",
        "description": "A piece of the answer text, in order."
      },
      "ChatToolEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "tool",
            "title": "Type"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          }
        },
        "type": "object",
        "required": [
          "type",
          "name",
          "arguments"
        ],
        "title": "ChatToolEvent",
        "description": "The agent called a tool, with its arguments; sent before the answer text (F-07)."
      },
      "ChatUsage": {
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens"
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens"
          },
          "first_token_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Token Ms"
          },
          "total_ms": {
            "type": "number",
            "title": "Total Ms"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "tool_turns": {
            "type": "integer",
            "title": "Tool Turns"
          }
        },
        "type": "object",
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "first_token_ms",
          "total_ms",
          "attempts",
          "tool_turns"
        ],
        "title": "ChatUsage",
        "description": "What the answer cost: tokens over every attempt, and its timings in milliseconds."
      },
      "ChunkSummary": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "location": {
            "$ref": "#/components/schemas/CitationLocation"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "position",
          "location"
        ],
        "title": "ChunkSummary",
        "description": "A passage of a document: its id and where it is, without its text."
      },
      "CitationLocation": {
        "properties": {
          "heading_path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Heading Path"
          },
          "article": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article"
          },
          "paragraph": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paragraph"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          }
        },
        "type": "object",
        "required": [
          "heading_path",
          "article",
          "paragraph",
          "page"
        ],
        "title": "CitationLocation",
        "description": "Where the cited passage is; parts the document does not have are empty."
      },
      "DocumentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "ready",
              "failed"
            ],
            "title": "Status"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count"
          },
          "page_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Count"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "filename",
          "status",
          "chunk_count",
          "page_count",
          "failure_reason"
        ],
        "title": "DocumentResponse"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail",
        "description": "One problem with one field of a request."
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "description": "The body of every error the API reports (PY-22)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "network": {
            "type": "boolean",
            "title": "Network"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "network"
        ],
        "title": "HealthResponse"
      },
      "ModelChoiceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "is_test_model": {
            "type": "boolean",
            "title": "Is Test Model"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default"
          }
        },
        "type": "object",
        "required": [
          "id",
          "is_test_model",
          "is_default"
        ],
        "title": "ModelChoiceResponse",
